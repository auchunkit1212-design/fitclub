# 同主 app（Nutrition Coach）共用同一組 Supabase / OpenRouter / Pro allowlist
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 食咩好本身網址（本地預設 3001）
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# 主 app 開 Pro／註冊入口（共用訂閱）
MAIN_APP_URL=http://localhost:3000
MAIN_APP_BILLING_URL=http://localhost:3000/billing
MAIN_APP_REGISTER_URL=http://localhost:3000/register

# OpenRouter（一週餐單 AI）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=What to Eat

# 可選：額外 Pro email（逗號分隔），同主 app 邏輯
PRO_EMAIL_ALLOWLIST=

# Capacitor iOS 殼載入 URL（上線後改正式網域）
CAPACITOR_SERVER_URL=http://localhost:3001
